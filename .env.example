# Copy to .env and fill in. Never commit .env.
# Every setting is read by hrm.core.config.Settings with the HRM_ prefix.

# --- LLM (Groq) ---
HRM_GROQ_API_KEY=
HRM_ANSWER_MODEL=openai/gpt-oss-120b
HRM_FAST_MODEL=openai/gpt-oss-20b

# --- Retrieval (defaults chosen by evaluation; see README "Retrieval design") ---
# HRM_RETRIEVAL_MODE=hybrid     # dense | bm25 | hybrid
# HRM_RERANK=true               # cross-encoder reranking of the candidates
# HRM_RETRIEVE_K=20             # candidates per retriever / for the reranker (10 = faster)

# --- Logging ---
HRM_LOG_LEVEL=INFO
# "console" for humans, "json" for machines/CI
HRM_LOG_FORMAT=console
