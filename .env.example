# Copy to .env and fill in. Never commit .env.
# Every setting is read by hrm.core.config.Settings with the HRM_ prefix.

# --- LLM (Groq) ---
HRM_GROQ_API_KEY=
HRM_ANSWER_MODEL=openai/gpt-oss-120b
HRM_FAST_MODEL=openai/gpt-oss-20b

# --- Logging ---
HRM_LOG_LEVEL=INFO
# "console" for humans, "json" for machines/CI
HRM_LOG_FORMAT=console
